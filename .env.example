# ── Required ───────────────────────────────────────────────────────────────────
TG_API_ID=123456
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_GROUP=my_group_username         # @username / invite link / numeric id

# ── Session ─────────────────────────────────────────────────────────────────────
# For Railway/cloud (stateless): generate once with gen_session.py
TG_SESSION_STRING=1BVtsOK...
# For local dev only (file-based):
# TG_SESSION=session

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Tuning (all optional) ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CACHE_DIR=/tmp/tg_cache
CHUNK_SIZE=524288          # 512 KB
MIN_HITS=2                 # cache to disk after N requests
META_TTL=1800              # Redis metadata TTL (30 min)
HITS_TTL=86400             # hit counter TTL (24 h)
LOCK_TTL=90                # download lock timeout (90 s)
DISK_MAX_GB=2.0            # max disk usage before LRU eviction
